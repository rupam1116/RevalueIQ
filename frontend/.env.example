# Production API URL
NEXT_PUBLIC_API_URL="https://revalueiq.onrender.com"

# Firebase Configuration (Public Keys)
NEXT_PUBLIC_FIREBASE_API_KEY="your-api-key-here"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-auth-domain-here.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-storage-bucket.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
NEXT_PUBLIC_FIREBASE_APP_ID="your-app-id"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="your-measurement-id"

# Map Provider ("osm" for free OpenStreetMap/Leaflet, "google" for Google Maps JS)
NEXT_PUBLIC_REPAIR_MAP_PROVIDER="osm"

# Google Maps JavaScript API (Client-restricted Public Key, optional if using osm)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-browser-api-key"

