# App Configuration
PROJECT_NAME="RevalueIQ API"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True
PORT=8000

# CORS Configuration (Comma-separated allowed origins)
FRONTEND_URL="http://localhost:3000,http://127.0.0.1:3000"

# MongoDB Atlas Configuration
MONGODB_URI="mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DATABASE_NAME="revalueiq"

# Firebase Admin SDK Configuration
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="your-firebase-client-email@project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-private-key\n-----END PRIVATE KEY-----"
FIREBASE_SERVICE_ACCOUNT_PATH="secrets/firebase-service-account.json"

# External AI & Cloud Services
GEMINI_API_KEY=
GEMINI_MODEL="gemini-3.6-flash"

# Cloudinary Image Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Maps Platform / Places API Configuration (Required if REPAIR_MAP_PROVIDER=google)
GOOGLE_MAPS_API_KEY=

# Map & Repair Provider ("osm" for free OpenStreetMap/Leaflet/Nominatim, "google" for Google Maps Platform)
REPAIR_MAP_PROVIDER="osm"

# Payment Gateway Configuration (Razorpay - INR)
PAYMENT_GATEWAY="razorpay"
PAYMENT_KEY_ID="rzp_test_your_key_id"
PAYMENT_KEY_SECRET="your_razorpay_secret_key"
PAYMENT_WEBHOOK_SECRET="your_razorpay_webhook_secret"


