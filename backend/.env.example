PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# MongoDB Connection String (Required for saving appraisals and profiles)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/revalueiq?retryWrites=true&w=majority

# Gemini AI API Key (Required for device analysis)
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudinary Setup (Required for image uploads)
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Firebase Admin SDK Configuration (Required for verifying authentication tokens)
# Paste the entire content of firebase-service-account.json here as a single minified string
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"..."}
